# Inline content editor — copy to .env.local for development, and set the same
# names in Vercel → Settings → Environment Variables for production.
#
# With none of these set the editor is simply off: no sign-in page is generated,
# the API endpoints refuse, and the site builds and serves exactly as before.

# The password for the editor.
CMS_PASSWORD=

# Signing key for the session cookie. Must be at least 16 characters.
# Generate one with:  openssl rand -base64 32
CMS_SECRET=

# The secret URL the sign-in page lives at — https://yoursite.com/<CMS_PATH>.
# There is no /edit or /admin: the address itself is the first lock, which is
# why it lives here and never in the repository. 16–64 characters of
# [A-Za-z0-9_-]. Generate one with:  openssl rand -hex 16
# Changing it moves the page on the next deploy.
CMS_PATH=

# --- Publishing target -------------------------------------------------------
# Without GITHUB_TOKEN the editor writes content/site.json and public/images on
# local disk, which is what you want for `npm run dev`. With it, saving commits
# to GitHub and Vercel rebuilds.
#
# Create a fine-grained personal access token at
#   github.com/settings/personal-access-tokens
# scoped to this repository only, with Repository permissions →
# Contents: Read and write. Nothing else.
GITHUB_TOKEN=
GITHUB_REPO=maryamy-m/portfolio
GITHUB_BRANCH=main

# Name and email recorded on commits the editor makes. Optional.
GITHUB_COMMIT_NAME=Portfolio Editor
GITHUB_COMMIT_EMAIL=editor@users.noreply.github.com
